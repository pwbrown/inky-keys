{
  "name": "inky-keys",
  "version": "2.34.1",
  "private": true,
  "description": "An offline-first, open-source typing game where you choose which keys to practice.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "words:build": "node scripts/build-words.ts",
    "icons": "python3 scripts/make-icons.py",
    "transcript": "node scripts/export-transcript.ts",
    "snapshots": "node scripts/snapshots.ts",
    "release:tag": "node scripts/tag-release.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "jsqr": "^1.4.0",
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "naughty-words": "^1.2.0",
    "nspell": "^2.1.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wordlist-english": "^1.2.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
